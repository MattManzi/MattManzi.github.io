{
  "name": "mattiamanzi",
  "main": "cloudflare/src/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mattia-site-analytics",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "assets": {
    "directory": "cloudflare/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/analytics/*",
      "/statistiche*"
    ]
  }
}
